[color]
	diff = auto
	status = auto
	branch = auto
	grep = auto
	sh = auto

[user]
	name = Kent Chen
	email = kent.chen@vivint.com

[core]
	whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
	autocrlf = false
	excludesfile = ~/.gitignore
	commitGraph = true

[alias]
	aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /' | sort

	br = branch
	branchdiff = !bash -c \"git diff `git oldest-ancestor`...$@\"
	branchdirdiff = !bash -c \"git dirdiff `git oldest-ancestor`...$@\"
	branchlog = !bash -c \"git log `git oldest-ancestor`..$@\"
	branchall = !git for-each-ref --sort=committerdate --format='%(refname:short) * %(authorname) * %(committerdate:relative)' refs/remotes/ | column -t -s '*'
	oldest-ancestor = !bash -c 'diff --old-line-format='' --new-line-format='' <(git rev-list --first-parent "${1:-master}") <(git rev-list --first-parent "${2:-HEAD}") | head -1' -

	ci = commit --verbose
	co = checkout
	co-master-force = "!f() { git reset --hard; git checkout master; git sub-update; }; f"
	dc = diff --cached

	dirdiff = difftool --dir-diff --extcmd=dirdiff
	dt = difftool
	meld = !git-meld.pl

	files = "!f() { git diff --name-status $1^ $1; }; f"

	clog = log --graph --date=short --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cd) %C(bold blue)<%an>%Creset' --abbrev-commit
	lg = log --stat --decorate
	lg-verbose = log --stat --decorate -p
	lo = log --oneline

	;pull = pull --rebase

	; For Github PR review
	prdiff = !git diff master...
	prdirdiff = !git dirdiff master...
	prlog = !git log master..
	prtig = !tig master..
	prcr = "!f() { git pr $1 && git dirdiff master...; }; f"

	; For Gitlab MR review
	;mr = "!f() { git fetch origin refs/merge-requests/$1/head:mr-$1 && git checkout mr-$1; }; f"
	mrcr = "!f() { git mr $1 && git dirdiff master...; }; f"

	; git-flow: What else PRs to be merged between this branch and master
	pr2merge = "!f() { git log --merges --pretty=format:\"%ai '%h' %s <%an>\" ..master | grep \"Merge pull request\" | sort; }; f"

	root = rev-parse --show-toplevel

	s = status --short
	st = status

	show-vim = "!f() { git dirdiff $1^ $1; }; f"

	;sync = "!git stash; git pull --rebase --all; git push --all; git stash pop"
	sync-r = "!git stash; git pull --force --all --tags -f; git remote prune origin; git pr clean; git stash pop; git sub-update"
	pullf = "!git fetch origin && git reset --hard origin/$(git branch --show-current) && git clean -fd"

	; purge
	purge = "!f() { read -p 'Continue (Y/n)? ' CONFIRM; [ $CONFIRM = 'Y' ] && { git stash drop; git reset --hard; git clean -dffx; } }; f"
	purge-force = "!f() { git stash drop; git reset --hard; git clean -dffx; }; f"

	; Undo a `git push`
	undopush = push -f origin HEAD^:master

	# use --set-upstream by default
	pushu = push -u

	pushf = push --force-with-lease --force-if-includes
	branchpushf = "!f() { git push -f origin HEAD:refs/heads/$1; }; f"

	zip = !git archive --format tar.gz -o $(git log --date=short --pretty=format:"%ad" -1).tar.gz HEAD

	# Get the child commit of the current commit
	# Use $1 instead of 'HEAD' if given
	# Use $2 instead of curent branch if given
	child = "!bash -c 'git log --format=%h --reverse --ancestry-path ${1:-HEAD}..${2:\"$(git rev-parse --abbrev-ref HEAD)\"} | head -1' -"

	# Rebase onto origin/${1:-master} and test by push --dry-run
	rebase-and-push = "!f() { tgt_branch=${1:-master}; git pull origin || git branch --set-upstream-to=origin/$(git rev-parse --abbrev-ref HEAD) && git fetch origin && git rebase origin/${tgt_branch} && git branch --set-upstream-to=origin/$(git rev-parse --abbrev-ref HEAD) && git push -n --force-with-lease --force-if-includes && git push --force-with-lease --force-if-includes; }; f"
	rap = !git rebase-and-push

	# sort git tags by date
	tags = tag --sort=v:refname

	# verbose tags info
	tags-annotated-verbose = !"git for-each-ref \
	--sort=taggerdate \
	--format '%(tag)_,,,_%(taggerdate:raw)_,,,_%(taggername)_,,,_%(subject)' refs/tags \
	| awk 'BEGIN { FS = \"_,,,_\"  } ; { t=strftime(\"%Y-%m-%d  %H:%M\",$2); printf \"%-20s %-18s %-25s %s\\n\", t, $1, $4, $3  }'"

	tags-verbose = !"git for-each-ref \
	--sort=taggerdate \
	--format '%(refname:short)_,,,_%(taggerdate:raw)_,,,_%(taggername)_,,,_%(subject)' refs/tags \
	| awk 'BEGIN { FS = \"_,,,_\"  } ; { t=strftime(\"%Y-%m-%d  %H:%M\",$2); printf \"%-20s %-18s %-25s %s\\n\", t, $1, $4, $3  }'"

	fixup = "!git stash; git rebase -i --autosquash HEAD~2"
	;fixupraw = "!git add -p && git commit --fixup=HEAD && git stash && EDITOR=true git rebase -i --autosquash HEAD~2 && git stash pop"

	search = "!git branch -a --contains"

	# Recursively sync all submodules according to what has been committed on the current branch.
	# Also recursively clone any submodules that haven't been cloned yet.
	sub-update = "!git submodule foreach 'git stash'; git submodule sync && git submodule update --init --recursive; git submodule foreach 'git stash pop || true'"

	# purge all submodules
	sub-purge = "!git submodule foreach --recursive 'git purge || true'; git sub-update"
	sub-purge-force = "!git submodule foreach --recursive 'git purge-force || true'; git sub-update"

	# handy for submodules in use cases
	clone-all = clone --recurse-submodules
	pull-all = pull --recurse-submodules

[branch]
	autosetupmerge = true
	autosetuprebase = always

[github]
	user = chenkaie

[color "sh"]
	branch = yellow ul
	workdir = blue bold
	dirty = red

[merge]
	tool = vimdiff

[diff]
	tool = vimdiff

[difftool]
	prompt = false

# push easily. http://stackoverflow.com/a/23918418/89484
[push]
	default = current

[help]
	autocorrect = 1

[http]
	sslVerify = false
	;proxy = http://172.16.2.54:8888/

[init]
	; custom git hooks
	;templatedir = ~/.git_template
	defaultBranch = main

[commit]
	;template = ~/.git_template/commit-template.txt

;[pager]
	;diff = diff-so-fancy | less --tabs=4 -RFX
	;show = diff-so-fancy | less --tabs=4 -RFX

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[rerere]
	enabled = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = line-numbers decorations #side-by-side
	whitespace-error-style = 22 reverse

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none

